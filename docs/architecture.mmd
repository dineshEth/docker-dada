        prodApi["API Container\nNo reload"]
        prodRedis["Redis Container\nWith persistence"]
        
        prodCompose --> prodApi
        prodCompose --> prodRedis
        prodApi --> prodRedis
    end
    
    %% ---------------------------------------------------------------------------
    %% Deployment Flow
